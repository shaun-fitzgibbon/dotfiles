# If you come from bash you might have to change your $PATH.
export PATH="/usr/local/sbin:$PATH"
export ZSH="$HOME/.oh-my-zsh"

# Starship manages the prompt; keep Oh My Zsh for plugins only.
ZSH_THEME=""

source ~/.config/zsh/catppuccin_macchiato-zsh-syntax-highlighting.zsh
DISABLE_MAGIC_FUNCTIONS=true

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)

# Uncomment one of the following lines to change the auto-update behavior
# zstyle ':omz:update' mode auto      # update automatically without asking
# zstyle ':omz:update' frequency 13

# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Add wisely, as too many plugins slow down shell startup.
plugins=( 
  # Standard plugins
  fnm
  fzf
  gh
  macos
  nvm
  tmux
  web-search
  
  # Custom plugins...
  zsh-autosuggestions
  zsh-syntax-highlighting
)
source $ZSH/oh-my-zsh.sh

# Tmux sessionizer Fzf
bindkey -s ^f "tmux-sessionizer.sh\n"

# # You may need to manually set your language environment
export LANG=en_US.UTF-8

# GPG 
export GPG_TTY=$(tty)


# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# custom scripts folder 
export SCRIPTS_LOCAL="/Users/shaun/.local/scripts"
case ":$PATH:" in
  *":$SCRIPTS_LOCAL:"*) ;;
  *) export PATH="$SCRIPTS_LOCAL:$PATH" ;;
esac

# Java with Jenv
export PATH="$HOME/.jenv/bin:$PATH"
export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"
eval "$(jenv init -)"

# pnpm 
export PNPM_HOME="/Users/shaun/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Prefer Homebrew binaries, including OpenCode 2.
export PATH="/opt/homebrew/bin:$PATH"

# Initialize fnm after other PATH changes so its Node and npm take priority.
export PATH="/Users/shaun/Library/Application Support/fnm:$PATH"
eval "$(fnm env --use-on-cd)"

# Mac setup for pomo
# Requires https://github.com/caarlos0/timer to be installed
alias work="timer 60m && terminal-notifier -message 'Pomodoro'\
        -title 'Work Timer is up! Take a Break 😊'\
        -appIcon \"$HOME/Pictures/pumpkin.png\"\
        -sound Crystal"
        
alias rest="timer 10m && terminal-notifier -message 'Pomodoro'\
        -title 'Break is over! Get back to work 😬'\
        -appIcon \"$HOME/Pictures/pumpkin.png\"\
        -sound Crystal"

# Aliases
alias connect="kitty +kitten ssh"
alias cdk="npx aws-cdk"
alias vim="nvim"

# Keep prompt initialization after plugins and environment setup.
eval "$(starship init zsh)"
